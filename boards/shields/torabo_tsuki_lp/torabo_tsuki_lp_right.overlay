#include "torabo_tsuki_lp.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

&pointing_listener {
    input-processors = <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>;
};

&size_s_transform {
    col-offset = <7>;
};

&size_m_transform {
    col-offset = <7>;
};

&size_l_transform {
    col-offset = <7>;
};

pointing_listener: pointing_listener {
    compatible = "zmk,input-listener";
    device = <&pointing_device>; // ラベル名は環境に合わせて調整してください
    
    /* オートマウスレイヤーの設定 */
    input-processors = <&zip_temp_layer 1 10000>;
};
